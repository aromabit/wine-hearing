# Lambda Function URL emitted by the SAM stack (api/template.yaml).
# Leave empty to keep evaluations in LocalStorage only.
NEXT_PUBLIC_EVALUATIONS_API_URL=

# Shared secret sent as the x-api-key header. Must match the ApiKey parameter
# of the SAM stack. This value is bundled into the static build, so it only
# discourages casual access.
NEXT_PUBLIC_EVALUATIONS_API_KEY=
